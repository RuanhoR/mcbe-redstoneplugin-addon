{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "redstoneplugin:container_entity",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
    "components": {
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },
      "minecraft:collision_box": {
        "width": 1.2,
        "height": 1.0
      },
      "minecraft:type_family": {
        "family": ["inanimate"]
      },
      "minecraft:inventory": {
        "container_type": "minecart_chest",
        "can_be_siphoned_from": true,
        "inventory_size": 27
      },
      "minecraft:knockback_resistance": {
        "value": 1
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "monster"
              }
            },
            "deals_damage": false
          },
          {
            "on_damage": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              }
            },
            "deals_damage": false
          }
        ]
      }
    }
  }
}
