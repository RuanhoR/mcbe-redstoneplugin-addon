<Component>
  <blocks>
    <block id="redstone_cutblock.json">cutBlock</block>
    <block id="redstone_placeblock.json">placeBlock</block>
  </blocks>
</Component>
<script lang="ts">
import { BlockComponent } from "@mbler/mcx-component";

type Rotation = [number, number, number];

const HORIZONTAL_ROTATIONS: Record<string, Rotation> = {
  north: [-90, 180, 0],
  south: [-90, 0, 0],
  west: [-90, -90, 0],
  east: [-90, 90, 0],
};

const UP_ROTATIONS: Record<string, Rotation> = {
  north: [180, 180, 0],
  south: [180, 0, 0],
  west: [180, -90, 0],
  east: [180, 90, 0],
};

const DOWN_ROTATIONS: Record<string, Rotation> = {
  north: [0, 180, 0],
  south: [0, 0, 0],
  west: [0, -90, 0],
  east: [0, 90, 0],
};

const CUSTOM_COMPONENT_ID = "redstoneplugin:controller";

interface MachineTextures {
  front: string;
  back: string;
  side: string;
}

function makeMachineBlock(id: string, textures: MachineTextures) {
  const block = new BlockComponent({
    format: "1.26.40",
    id,
    menu_category: { category: "construction" },
  });

  block.setTraits({
    "minecraft:placement_direction": {
      enabled_states: [
        "minecraft:cardinal_direction",
        "minecraft:facing_direction",
      ],
    },
  });

  for (const [dir, rotation] of Object.entries(HORIZONTAL_ROTATIONS)) {
    block.addPermutation(
      `query.block_state('minecraft:facing_direction') == '${dir}'`,
      { "minecraft:transformation": { rotation } },
    );
  }
  for (const [dir, rotation] of Object.entries(UP_ROTATIONS)) {
    block.addPermutation(
      `query.block_state('minecraft:facing_direction') == 'up' && query.block_state('minecraft:cardinal_direction') == '${dir}'`,
      { "minecraft:transformation": { rotation } },
    );
  }
  for (const [dir, rotation] of Object.entries(DOWN_ROTATIONS)) {
    block.addPermutation(
      `query.block_state('minecraft:facing_direction') == 'down' && query.block_state('minecraft:cardinal_direction') == '${dir}'`,
      { "minecraft:transformation": { rotation } },
    );
  }

  block.setCollisionBox({ origin: [-8, 0, -8], size: [16, 16, 16] });
  block.setRedstoneConsumer({ min_power: 1 });
  block.setCustomComponents([CUSTOM_COMPONENT_ID]);
  block.setGeometry("minecraft:geometry.full_block");
  block.setBlockEntity({ dynamic_properties: true });

  const materialInstances = {
    north: { texture: textures.side },
    south: { texture: textures.side },
    east: { texture: textures.side },
    west: { texture: textures.side },
    up: { texture: textures.front },
    down: { texture: textures.back },
  };
  block.setMaterialInstances(materialInstances);
  block.setItemVisual({
    geometry: "minecraft:geometry.full_block",
    material_instances: materialInstances,
  });

  return block;
}

export const cutBlock = makeMachineBlock("redstoneplugin:cutblock", {
  front: "cutblock_front",
  back: "cutblock_back",
  side: "cutblock_side",
});

export const placeBlock = makeMachineBlock("redstoneplugin:placeblock", {
  front: "placeblock_front",
  back: "placeblock_back",
  side: "placeblock_side",
});
</script>
